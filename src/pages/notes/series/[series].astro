---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import NotesIndexView from '../../../components/content/NotesIndexView.astro';
import NoteRow from '../../../components/content/NoteRow.astro';
import { filterByLang } from '../../../lib/content/collections';
import { getSeriesNotes, getSeriesSummaries, seriesIndexPath, seriesPath } from '../../../lib/content/blog';

export async function getStaticPaths() {
  const allNotes = await getCollection('notes');
  return getSeriesSummaries(allNotes, 'ko').map((item) => ({ params: { series: item.slug }, props: { name: item.name } }));
}

const { name } = Astro.props as { name: string };
const allNotes = await getCollection('notes');
const notes = getSeriesNotes(allNotes, name, 'ko');
const recordCount = filterByLang(await getCollection('records'), 'ko').length;
const alternatePath = getSeriesSummaries(allNotes, 'en').some((item) => item.name === name)
  ? seriesPath(name, 'en')
  : seriesIndexPath('en');
---

<Base title={name} page="notes" lang="ko" alternatePath={alternatePath} wide>
  <NotesIndexView lang="ko" allNotes={allNotes} recordCount={recordCount} title={name} lede={`${notes.length}편 · 읽는 순서대로`}>
    {notes.map((note) => <NoteRow note={note} />)}
  </NotesIndexView>
</Base>
