---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NoteArticle from '../../components/content/NoteArticle.astro';
import { findTranslation, getEntryPath, getLocalizedStaticPaths } from '../../lib/content/collections';
import { notesPath } from '../../lib/content/blog';

export async function getStaticPaths() {
  return getLocalizedStaticPaths(await getCollection('notes'), 'ko', 'note', 'notes');
}

const { note } = Astro.props;
const allNotes = await getCollection('notes');
const translation = findTranslation(allNotes, note, 'en');
const alternatePath = translation ? getEntryPath('notes', translation) : notesPath('en');
---

<Base title={note.data.title} description={note.data.summary} page="notes" lang="ko" alternatePath={alternatePath} wide>
  <NoteArticle note={note} allNotes={allNotes} />
</Base>
