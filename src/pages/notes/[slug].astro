---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BadgeList from '../../components/ui/BadgeList.astro';
import {
  findTranslation,
  getLocalizedStaticPaths,
  getPublicEntrySlug,
} from '../../lib/content/collections';
import { getNoteFieldLabel } from '../../lib/content/fields';
import { getStatusLabel, getStatusTone } from '../../lib/content/status';
import CopyCode from '../../components/content/CopyCode.astro';

export async function getStaticPaths() {
  return getLocalizedStaticPaths(await getCollection('notes'), 'ko', 'note', 'notes');
}

const { note } = Astro.props;
const { Content } = await note.render();
const englishNote = findTranslation(await getCollection('notes'), note, 'en');
const alternatePath = englishNote
  ? `/en/notes/${getPublicEntrySlug('notes', englishNote)}/`
  : '/en/notes/';
---

<Base title={note.data.title} page="notes" lang="ko" alternatePath={alternatePath}>
  <article class="page-stack">
    <header class="page-header">
      <div class="metadata">
        <span>{(note.data.lastUpdated ?? note.data.date).toISOString().slice(0, 10)}</span>
        <span>{getNoteFieldLabel(note.data.field, note.data.lang)}</span>
        {note.data.series && <span>{note.data.series}</span>}
        <span>{note.data.category}</span>
        <span data-tone={getStatusTone(note.data.status)}>{getStatusLabel(note.data.status, note.data.lang)}</span>
      </div>
      <h1 class="page-title">{note.data.title}</h1>
      <p class="lede">{note.data.summary}</p>
      <BadgeList items={note.data.tags} />
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <CopyCode />
</Base>
