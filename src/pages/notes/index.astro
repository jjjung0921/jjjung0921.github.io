---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NotesIndexView from '../../components/content/NotesIndexView.astro';
import NoteRow from '../../components/content/NoteRow.astro';
import { filterByLang, sortByDateDesc } from '../../lib/content/collections';
import { notesPath } from '../../lib/content/blog';

const allNotes = await getCollection('notes');
const notes = sortByDateDesc(filterByLang(allNotes, 'ko'));
const recordCount = filterByLang(await getCollection('records'), 'ko').length;
---

<Base title="노트" page="notes" lang="ko" alternatePath={notesPath('en')} wide>
  <NotesIndexView lang="ko" allNotes={allNotes} recordCount={recordCount} title="노트" lede="연구와 프로젝트를 하며 생긴 질문을 분야와 시리즈로 묶었습니다." currentField="all">
    {notes.map((note) => <NoteRow note={note} />)}
  </NotesIndexView>
</Base>
