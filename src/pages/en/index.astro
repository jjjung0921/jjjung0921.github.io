---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Icon from '../../components/ui/Icon.astro';
import finalGoalFigure from '../../../.bilevel-figure/personalized-agentic-ai.png';
import ddaFigure from '../../../.bilevel-figure/dda-personalized-response-model.png';
---

<Base
  title="Bit City Lab"
  page="home"
  lang="en"
  alternatePath="/"
  description="A personal research interface for AI, games, optimization, and computational systems."
>
  <div class="page-stack">
    <PageHeader
      eyebrow="Portfolio"
      title="Bit City Lab"
      lede="A personal research interface for AI, games, optimization, and computational systems."
      variant="hero"
    />

    <section class="quote-panel">
      <p class="lede">
        I think of computer science as reading the flow of data and building a city on the land
        called memory — one with the infrastructure that lets data travel safely, correctly, and
        efficiently. I study how that city redesigns itself around its residents, through the lens
        of bi-level optimization.
      </p>
      <div class="button-row">
        <a class="button primary" href="/en/cv/">View CV</a>
        <a class="button secondary" href="/en/projects/">Explore Projects</a>
        <a class="button secondary" href="/en/lab/">Enter Lab</a>
        <a class="button secondary" href="/en/notes/">Read Notes</a>
      </div>
    </section>

    <section class="identity-grid" aria-label="Identity snapshot">
      <article class="identity-item">
        <span class="icon-tile"><Icon name="network" size={22} /></span>
        <p class="eyebrow">Learning</p>
        <h2>Learning by Reconstruction</h2>
        <p>I rebuild a method from the limitation it answers, until I understand why it has to look the way it does.</p>
      </article>
      <article class="identity-item">
        <span class="icon-tile"><Icon name="cpu" size={22} /></span>
        <p class="eyebrow">Engineering</p>
        <h2>Tracing Data</h2>
        <p>Every computation is data moving across memory. I tune the tradeoff between machine efficiency and code clarity so data travels safely, correctly, and efficiently.</p>
      </article>
      <article class="identity-item">
        <span class="icon-tile"><Icon name="box" size={22} /></span>
        <p class="eyebrow">Research</p>
        <h2>Synthesizing Tailored AI</h2>
        <p>My final goal is to design AI models customized to an individual user, adapting dynamically as they are used — synthesized through bi-level optimization rather than hand-tuned.</p>
      </article>
    </section>

    <section class="card">
      <p class="eyebrow">Final goal</p>
      <h2 class="section-title">AI That Dynamically Adapts to a Person</h2>
      <p>
        What I ultimately want to build is a city that redesigns itself for a single resident — an
        AI model customized to an individual user, dynamically adapting to them. Dynamic difficulty
        adjustment (DDA) is my first testing ground for this goal.
      </p>
      <figure class="home-figure">
        <img
          src={finalGoalFigure.src}
          width={finalGoalFigure.width}
          height={finalGoalFigure.height}
          alt="A bi-level AI model learns an individual’s state and responses from interaction history, then adapts its next action to that person"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </section>

    <section class="card">
      <p class="eyebrow">Current research direction</p>
      <h2 class="section-title">Dynamic Difficulty Adjustment as Bi-level Optimization</h2>
      <p>
        Just as a city relays its roads around its residents' movement, the upper level selects
        difficulty parameters, reward weights, environment settings, or opponent policies, while
        at the lower level players and agents respond through behavioral adaptation.
      </p>
      <figure class="home-figure">
        <img
          src={ddaFigure.src}
          width={ddaFigure.width}
          height={ddaFigure.height}
          alt="A DDA bi-level model in which a difficulty policy shapes interaction data used to fit a player response model and choose the next difficulty"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </section>
  </div>
</Base>

<style>
  .home-figure {
    margin: 1.4rem 0 0;
  }

  .home-figure img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
