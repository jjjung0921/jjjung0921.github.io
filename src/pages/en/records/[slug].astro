---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import RecordArticle from '../../../components/content/RecordArticle.astro';
import { findTranslation, getEntryPath, getLocalizedStaticPaths } from '../../../lib/content/collections';
import { recordsPath } from '../../../lib/content/blog';

export async function getStaticPaths() {
  return getLocalizedStaticPaths(await getCollection('records'), 'en', 'record', 'records');
}

const { record } = Astro.props;
const translation = findTranslation(await getCollection('records'), record, 'ko');
const alternatePath = translation ? getEntryPath('records', translation) : recordsPath('ko');
---

<Base title={record.data.title} description={record.data.summary} page="notes" lang="en" alternatePath={alternatePath} wide>
  <RecordArticle record={record} />
</Base>
