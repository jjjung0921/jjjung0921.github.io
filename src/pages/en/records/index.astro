---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import RecordsIndexView from '../../../components/content/RecordsIndexView.astro';
import { filterByLang } from '../../../lib/content/collections';
import { recordsPath } from '../../../lib/content/blog';

const allRecords = await getCollection('records');
const noteCount = filterByLang(await getCollection('notes'), 'en').length;
---

<Base title="Records" page="notes" lang="en" alternatePath={recordsPath('ko')} wide>
  <RecordsIndexView lang="en" allRecords={allRecords} noteCount={noteCount} currentKind="all" />
</Base>
