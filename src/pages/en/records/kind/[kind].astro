---
import { getCollection } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import RecordsIndexView from '../../../../components/content/RecordsIndexView.astro';
import { filterByLang } from '../../../../lib/content/collections';
import { getRecordKindLabel, recordKindOrder, recordKindPath, recordsPath, type RecordKind } from '../../../../lib/content/blog';

export async function getStaticPaths() {
  const records = filterByLang(await getCollection('records'), 'en');
  return recordKindOrder
    .filter((kind) => records.some((record) => record.data.kind === kind))
    .map((kind) => ({ params: { kind }, props: { kind } }));
}

const { kind } = Astro.props as { kind: RecordKind };
const allRecords = await getCollection('records');
const noteCount = filterByLang(await getCollection('notes'), 'en').length;
const alternatePath = filterByLang(allRecords, 'ko').some((record) => record.data.kind === kind)
  ? recordKindPath(kind, 'ko')
  : recordsPath('ko');
---

<Base title={getRecordKindLabel(kind, 'en')} page="notes" lang="en" alternatePath={alternatePath} wide>
  <RecordsIndexView lang="en" allRecords={allRecords} noteCount={noteCount} currentKind={kind} />
</Base>
