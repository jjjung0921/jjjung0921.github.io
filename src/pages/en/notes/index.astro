---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import NotesIndexView from '../../../components/content/NotesIndexView.astro';
import NoteRow from '../../../components/content/NoteRow.astro';
import { filterByLang, sortByDateDesc } from '../../../lib/content/collections';
import { notesPath } from '../../../lib/content/blog';

const allNotes = await getCollection('notes');
const notes = sortByDateDesc(filterByLang(allNotes, 'en'));
const recordCount = filterByLang(await getCollection('records'), 'en').length;
---

<Base title="Notes" page="notes" lang="en" alternatePath={notesPath('ko')} wide>
  <NotesIndexView lang="en" allNotes={allNotes} recordCount={recordCount} title="Notes" lede="Questions from research and projects, grouped by field and series." currentField="all">
    {notes.map((note) => <NoteRow note={note} />)}
  </NotesIndexView>
</Base>
