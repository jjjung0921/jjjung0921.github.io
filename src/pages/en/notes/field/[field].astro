---
import { getCollection } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import NotesIndexView from '../../../../components/content/NotesIndexView.astro';
import NoteRow from '../../../../components/content/NoteRow.astro';
import { filterByLang, sortByDateDesc } from '../../../../lib/content/collections';
import { getNoteFieldLabel, type NoteField } from '../../../../lib/content/fields';
import { fieldPath, getFieldLinks, notesPath } from '../../../../lib/content/blog';

export async function getStaticPaths() {
  const allNotes = await getCollection('notes');
  return getFieldLinks(allNotes, 'en').map((link) => ({ params: { field: link.field }, props: { field: link.field } }));
}

const { field } = Astro.props as { field: NoteField };
const allNotes = await getCollection('notes');
const notes = sortByDateDesc(filterByLang(allNotes, 'en').filter((note) => note.data.field === field));
const recordCount = filterByLang(await getCollection('records'), 'en').length;
const label = getNoteFieldLabel(field, 'en');
const alternatePath = getFieldLinks(allNotes, 'ko').some((link) => link.field === field)
  ? fieldPath(field, 'ko')
  : notesPath('ko');
---

<Base title={`${label} · Notes`} page="notes" lang="en" alternatePath={alternatePath} wide>
  <NotesIndexView lang="en" allNotes={allNotes} recordCount={recordCount} title="Notes" lede={`Notes in ${label}.`} currentField={field}>
    {notes.map((note) => <NoteRow note={note} showField={false} />)}
  </NotesIndexView>
</Base>
