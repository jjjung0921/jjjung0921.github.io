---
import { getCollection } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import NotesIndexView from '../../../../components/content/NotesIndexView.astro';
import NoteRow from '../../../../components/content/NoteRow.astro';
import { filterByLang } from '../../../../lib/content/collections';
import { getSeriesNotes, getSeriesSummaries, seriesIndexPath, seriesPath } from '../../../../lib/content/blog';

export async function getStaticPaths() {
  const allNotes = await getCollection('notes');
  return getSeriesSummaries(allNotes, 'en').map((item) => ({ params: { series: item.slug }, props: { name: item.name } }));
}

const { name } = Astro.props as { name: string };
const allNotes = await getCollection('notes');
const notes = getSeriesNotes(allNotes, name, 'en');
const recordCount = filterByLang(await getCollection('records'), 'en').length;
const alternatePath = getSeriesSummaries(allNotes, 'ko').some((item) => item.name === name)
  ? seriesPath(name, 'ko')
  : seriesIndexPath('ko');
---

<Base title={name} page="notes" lang="en" alternatePath={alternatePath} wide>
  <NotesIndexView lang="en" allNotes={allNotes} recordCount={recordCount} title={name} lede={`${notes.length} posts · in reading order`}>
    {notes.map((note) => <NoteRow note={note} />)}
  </NotesIndexView>
</Base>
