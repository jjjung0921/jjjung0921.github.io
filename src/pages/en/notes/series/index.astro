---
import { getCollection } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import NotesIndexView from '../../../../components/content/NotesIndexView.astro';
import { filterByLang } from '../../../../lib/content/collections';
import { getSeriesSummaries, seriesIndexPath } from '../../../../lib/content/blog';

const allNotes = await getCollection('notes');
const series = getSeriesSummaries(allNotes, 'en');
const recordCount = filterByLang(await getCollection('records'), 'en').length;
---

<Base title="Series" page="notes" lang="en" alternatePath={seriesIndexPath('ko')} wide>
  <NotesIndexView lang="en" allNotes={allNotes} recordCount={recordCount} title="Series" lede="Posts meant to be read in sequence, most recently updated first." showRail={false}>
    {series.map((item) => (
      <a class="blog-row" href={item.href}>
        <h2 class="blog-row-title">{item.name}</h2>
        <p class="blog-row-meta"><span>{`${item.count} posts`}</span><span>Latest · {item.latest.data.title}</span></p>
      </a>
    ))}
  </NotesIndexView>
</Base>
