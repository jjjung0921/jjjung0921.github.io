---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import BadgeList from '../../../components/ui/BadgeList.astro';
import {
  findTranslation,
  getEntryPath,
  getLocalizedStaticPaths,
  getNoteSeriesNavigation,
  getPublicEntrySlug,
} from '../../../lib/content/collections';
import { getNoteFieldLabel } from '../../../lib/content/fields';
import { getStatusLabel, getStatusTone } from '../../../lib/content/status';
import CopyCode from '../../../components/content/CopyCode.astro';
import SeriesNavigation from '../../../components/content/SeriesNavigation.astro';

export async function getStaticPaths() {
  return getLocalizedStaticPaths(await getCollection('notes'), 'en', 'note', 'notes');
}

const { note } = Astro.props;
const { Content } = await note.render();
const notes = await getCollection('notes');
const koreanNote = findTranslation(notes, note, 'ko');
const seriesNavigation = getNoteSeriesNavigation(notes, note);
const alternatePath = koreanNote
  ? `/notes/${getPublicEntrySlug('notes', koreanNote)}/`
  : '/notes/';
---

<Base title={note.data.title} page="notes" lang="en" alternatePath={alternatePath}>
  <article class="page-stack">
    <header class="page-header">
      <div class="metadata">
        <span>{(note.data.lastUpdated ?? note.data.date).toISOString().slice(0, 10)}</span>
        <span>{getNoteFieldLabel(note.data.field, note.data.lang)}</span>
        {note.data.series && <span>{note.data.series}</span>}
        <span>{note.data.category}</span>
        <span data-tone={getStatusTone(note.data.status)}>{getStatusLabel(note.data.status, note.data.lang)}</span>
      </div>
      <h1 class="page-title">{note.data.title}</h1>
      <p class="lede">{note.data.summary}</p>
      <BadgeList items={note.data.tags} />
    </header>
    <div class="prose">
      <Content />
    </div>
    <SeriesNavigation
      lang="en"
      previous={seriesNavigation.previous && {
        href: getEntryPath('notes', seriesNavigation.previous),
        title: seriesNavigation.previous.data.title,
      }}
      next={seriesNavigation.next && {
        href: getEntryPath('notes', seriesNavigation.next),
        title: seriesNavigation.next.data.title,
      }}
    />
  </article>
  <CopyCode />
</Base>
