---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BadgeList from '../../components/ui/BadgeList.astro';
import NoteListItem from '../../components/content/NoteListItem.astro';
import {
  getLocalizedStaticPaths,
  getNotesForProject,
  getSlugWithoutLangPrefix,
} from '../../lib/content/collections';
import { getStatusLabel, getStatusTone } from '../../lib/content/status';

export async function getStaticPaths() {
  return getLocalizedStaticPaths(await getCollection('projects'), 'ko', 'project');
}

const { project } = Astro.props;
const { Content } = await project.render();
const slug = getSlugWithoutLangPrefix(project.slug);
const projectNotes = getNotesForProject(
  await getCollection('notes'),
  project.data.translationKey,
  project.data.lang,
);
---

<Base title={project.data.title} page="projects" lang="ko" alternatePath={`/en/projects/${slug}/`}>
  <article class="page-stack">
    <header class="page-header">
      <div class="metadata">
        <span data-tone={getStatusTone(project.data.status)}>{getStatusLabel(project.data.status, project.data.lang)}</span>
        <span>{project.data.role}</span>
        {project.data.timeRange && <span>{project.data.timeRange}</span>}
      </div>
      <h1 class="page-title">{project.data.title}</h1>
      <p class="lede">{project.data.problem}</p>
      <BadgeList items={[...project.data.tags, ...project.data.stack]} />
    </header>

    <section class="card project-card">
      <div class="project-detail-grid">
        <div class="metadata-block">
          <h3>제약 사항</h3>
          <p>{project.data.constraint}</p>
        </div>
        <div class="metadata-block">
          <h3>아키텍처</h3>
          <p>{project.data.architecture}</p>
        </div>
        <div class="metadata-block">
          <h3>실험</h3>
          <p>{project.data.experiment}</p>
        </div>
        <div class="metadata-block">
          <h3>기술적 핵심</h3>
          <ul>
            {project.data.technicalCore.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
      {project.data.outcome && (
        <div class="metadata-block">
          <h3>성과</h3>
          <p>{project.data.outcome}</p>
        </div>
      )}
      {project.data.researchRelevance && (
        <div class="metadata-block">
          <h3>연구 관련성</h3>
          <p>{project.data.researchRelevance}</p>
        </div>
      )}
    </section>

    <div class="prose">
      <Content />
    </div>

    <section class="page-stack" aria-labelledby="project-notes-title">
      <div>
        <p class="eyebrow">Project Notes</p>
        <h2 id="project-notes-title" class="section-title">프로젝트 노트</h2>
        <p class="lede">프로젝트를 진행하며 작성한 기록과 학습 노트입니다.</p>
      </div>
      {projectNotes.length > 0 ? (
        <div class="card-list">
          {projectNotes.map((note) => <NoteListItem note={note} />)}
        </div>
      ) : (
        <p class="lede">연결된 노트가 아직 없습니다.</p>
      )}
    </section>
  </article>
</Base>
