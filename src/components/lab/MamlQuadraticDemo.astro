---
import katex from 'katex';

interface Props {
  lang?: 'ko' | 'en';
}

const lang = Astro.props.lang ?? 'ko';
// 라벨의 수식은 빌드 때 KaTeX로 그린다 — 브라우저에서 유니코드로 흉내 내지 않는다.
const tex = (s: string) => katex.renderToString(s, { throwOnError: false, output: 'html' });

const copy = {
  ko: {
    figure: '이차 손실을 가진 여러 task 위에서 MAML·FOMAML·합동 학습이 찾는 출발점과 경로',
    alpha: `inner step size ${tex('\\alpha')}`,
    count: `task 수 ${tex('N')}`,
    spread: 'task 최적해의 흩어짐',
    batch: `meta-batch 크기 ${tex('B')}`,
    resampleTasks: 'task 다시 뽑기',
    resampleBatch: '배치 다시 뽑기',
    showBatch: '배치 경로',
    showFomaml: 'FOMAML 경로',
    showJoint: '합동 학습 경로',
    hint: '그림을 누르면 그 자리에서 출발한다.',
    readout: '출력',
    col: ['', 'MAML', '합동'],
    after: `적응 뒤 손실 ${tex('\\bar{\\mathcal L}(\\theta\')')}`,
    before: `적응 전 손실 ${tex('\\bar{\\mathcal L}(\\theta)')}`,
    gap: tex('\\lVert \\theta^\\star_{\\mathrm{MAML}} - \\theta^\\star_{\\mathrm{joint}} \\rVert'),
    curv: tex('\\alpha\\,\\max_i \\lambda_{\\max}(A_i)'),
    tail: `끝 구간 흩어짐 (${tex('B')})`,
    diverged: 'FOMAML 경로가 발산했다',
    chart: `배치 크기 ${tex('B')}별 끝 구간 흩어짐`,
    chartNote: 'MAML, seed 4개 평균, 마지막 100 step의 RMS 거리',
    legend: '범례',
    legendTask: 'task 최적해와 등고선',
    legendMaml: 'MAML 최적점 · 전체 배치 경로 · 등고선',
    legendBatch: `배치 ${tex('B')} 경로 (seed 3개)`,
    legendFomaml: 'FOMAML 정지점 · 경로',
    legendJoint: `합동 학습(${tex('\\alpha = 0')}) 최적점 · 경로`,
    legendAdapted: `출발점에서 한 걸음 적응한 ${tex('\\theta_i\'')}`,
  },
  en: {
    figure: 'Start points and paths that MAML, FOMAML and joint training find on several quadratic tasks',
    alpha: `inner step size ${tex('\\alpha')}`,
    count: `number of tasks ${tex('N')}`,
    spread: 'spread of task optima',
    batch: `meta-batch size ${tex('B')}`,
    resampleTasks: 'resample tasks',
    resampleBatch: 'resample batches',
    showBatch: 'batch paths',
    showFomaml: 'FOMAML path',
    showJoint: 'joint-training path',
    hint: 'Click the plot to start from that point.',
    readout: 'Output',
    col: ['', 'MAML', 'joint'],
    after: `after adapting ${tex('\\bar{\\mathcal L}(\\theta\')')}`,
    before: `before adapting ${tex('\\bar{\\mathcal L}(\\theta)')}`,
    gap: tex('\\lVert \\theta^\\star_{\\mathrm{MAML}} - \\theta^\\star_{\\mathrm{joint}} \\rVert'),
    curv: tex('\\alpha\\,\\max_i \\lambda_{\\max}(A_i)'),
    tail: `tail spread (${tex('B')})`,
    diverged: 'the FOMAML path diverged',
    chart: `tail spread by batch size ${tex('B')}`,
    chartNote: 'MAML, mean of 4 seeds, RMS distance over the last 100 steps',
    legend: 'Legend',
    legendTask: 'task optima and contours',
    legendMaml: 'MAML optimum · full-batch path · contours',
    legendBatch: `batch-${tex('B')} paths (3 seeds)`,
    legendFomaml: 'FOMAML stationary point · path',
    legendJoint: `joint training (${tex('\\alpha = 0')}) optimum · path`,
    legendAdapted: `${tex('\\theta_i\'')} after one step from the start`,
  },
}[lang];
---

<div class="lab-layout" data-maml-demo>
  <div class="lab-demo-frame maml-demo-frame">
    <figure class="maml-figure">
      <svg viewBox="0 0 640 480" role="img" aria-label={copy.figure} data-maml-svg>
        <g data-maml-layer></g>
      </svg>
    </figure>

    <div class="maml-controls">
      <div class="maml-control">
        <label class="lab-control-label"><span set:html={copy.alpha} /><span class="metric-pill" data-value="alpha"></span></label>
        <input class="lab-range" data-input="alpha" type="range" min="0" max="0.45" step="0.005" value="0.15" />
      </div>
      <div class="maml-control">
        <label class="lab-control-label"><span set:html={copy.count} /><span class="metric-pill" data-value="count"></span></label>
        <input class="lab-range" data-input="count" type="range" min="2" max="12" step="1" value="6" />
      </div>
      <div class="maml-control">
        <label class="lab-control-label"><span set:html={copy.spread} /><span class="metric-pill" data-value="spread"></span></label>
        <input class="lab-range" data-input="spread" type="range" min="0.3" max="1.6" step="0.01" value="1" />
      </div>
      <div class="maml-control">
        <label class="lab-control-label"><span set:html={copy.batch} /><span class="metric-pill" data-value="batch"></span></label>
        <input class="lab-range" data-input="batch" type="range" min="1" max="6" step="1" value="2" />
      </div>
    </div>

    <div class="maml-toggles">
      <button type="button" class="maml-button" data-action="tasks">{copy.resampleTasks}</button>
      <button type="button" class="maml-button" data-action="batches">{copy.resampleBatch}</button>
      <label><input type="checkbox" data-toggle="batch" checked /> {copy.showBatch}</label>
      <label><input type="checkbox" data-toggle="fomaml" /> {copy.showFomaml}</label>
      <label><input type="checkbox" data-toggle="joint" checked /> {copy.showJoint}</label>
    </div>
    <p class="maml-hint">{copy.hint}</p>
  </div>

  <aside class="lab-side-panel">
    <section class="card">
      <p class="eyebrow">{copy.readout}</p>
      <table class="maml-readout">
        <thead>
          <tr>{copy.col.map((c) => <th>{c}</th>)}</tr>
        </thead>
        <tbody>
          <tr><th set:html={copy.after} /><td data-out="after-maml"></td><td data-out="after-joint"></td></tr>
          <tr><th set:html={copy.before} /><td data-out="before-maml"></td><td data-out="before-joint"></td></tr>
        </tbody>
      </table>
      <dl class="maml-metrics">
        <dt set:html={copy.gap} /><dd data-out="gap"></dd>
        <dt set:html={copy.curv} /><dd data-out="curv"></dd>
        <dt set:html={copy.tail} /><dd data-out="tail"></dd>
      </dl>
      <p class="maml-warning" data-out="diverged" hidden>{copy.diverged}</p>
    </section>
    <section class="card">
      <p class="eyebrow" set:html={copy.chart} />
      <svg class="maml-chart" viewBox="0 0 240 120" role="img" aria-label="batch size chart" data-maml-chart></svg>
      <p class="maml-hint">{copy.chartNote}</p>
    </section>
    <section class="card">
      <p class="eyebrow">{copy.legend}</p>
      <ul class="maml-legend">
        <li><span class="swatch" data-series="task"></span>{copy.legendTask}</li>
        <li><span class="swatch" data-series="maml"></span><span>{copy.legendMaml}</span></li>
        <li><span class="swatch" data-series="batch"></span><span set:html={copy.legendBatch} /></li>
        <li><span class="swatch" data-series="fomaml"></span>{copy.legendFomaml}</li>
        <li><span class="swatch" data-series="joint"></span><span set:html={copy.legendJoint} /></li>
        <li><span class="swatch swatch-dot" data-series="adapted"></span><span set:html={copy.legendAdapted} /></li>
      </ul>
    </section>
  </aside>
</div>

<script>
  import {
    adapt,
    ellipse,
    levelForMajorRadius,
    lossAfter,
    lossBefore,
    makeTasks,
    maxCurvature,
    meanWeight,
    outerStep,
    spreadByBatch,
    stationary,
    trajectory,
    type Vec,
  } from '../../lib/lab/mamlQuadratic';

  const W = 640;
  const H = 480;
  const SCALE = 100;
  const sx = (x: number) => W / 2 + x * SCALE;
  const sy = (y: number) => H / 2 - y * SCALE;
  const toWorld = (px: number, py: number): Vec => [(px - W / 2) / SCALE, (H / 2 - py) / SCALE];
  const path = (pts: Vec[]) =>
    pts.map((p, k) => `${k ? 'L' : 'M'}${sx(p[0]).toFixed(1)},${sy(p[1]).toFixed(1)}`).join(' ');
  const dot = (p: Vec, cls: string, r = 5) =>
    `<circle class="${cls}" cx="${sx(p[0]).toFixed(1)}" cy="${sy(p[1]).toFixed(1)}" r="${r}" />`;
  const cross = (p: Vec, cls: string) => {
    const x = sx(p[0]);
    const y = sy(p[1]);
    return `<path class="${cls}" d="M${x - 5},${y - 5} L${x + 5},${y + 5} M${x - 5},${y + 5} L${x + 5},${y - 5}" />`;
  };
  const fmt = (v: number) => (Math.abs(v) < 5e-4 ? '0.000' : v.toFixed(3));
  const inView = (p: Vec) => Math.abs(p[0]) < 4 && Math.abs(p[1]) < 3;

  document.querySelectorAll<HTMLElement>('[data-maml-demo]').forEach((demo) => {
    const svg = demo.querySelector<SVGSVGElement>('[data-maml-svg]')!;
    const layer = demo.querySelector<SVGGElement>('[data-maml-layer]')!;
    const chart = demo.querySelector<SVGSVGElement>('[data-maml-chart]')!;
    const input = (k: string) => demo.querySelector<HTMLInputElement>(`[data-input="${k}"]`)!;
    const toggle = (k: string) => demo.querySelector<HTMLInputElement>(`[data-toggle="${k}"]`)!;
    const out = (k: string) => demo.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const value = (k: string) => demo.querySelector<HTMLElement>(`[data-value="${k}"]`)!;

    let start: Vec = [-2.6, -1.8];
    let taskSeed = 7;
    let batchSeed = 11;
    let queued = false;

    const drawChart = (values: number[], current: number) => {
      const top = Math.max(...values, 1e-6);
      const bw = 200 / values.length;
      const bars = values
        .map((v, i) => {
          const h = (v / top) * 84;
          const cls = i + 1 === current ? 'maml-bar is-current' : 'maml-bar';
          return `<rect class="${cls}" x="${(30 + i * bw + 1).toFixed(1)}" y="${(96 - h).toFixed(1)}" width="${(bw - 2).toFixed(1)}" height="${h.toFixed(1)}" />`;
        })
        .join('');
      const ticks = values
        .map((_, i) =>
          i === 0 || i === values.length - 1 || i + 1 === current
            ? `<text class="maml-tick" x="${(30 + (i + 0.5) * bw).toFixed(1)}" y="112" text-anchor="middle">${i + 1}</text>`
            : '',
        )
        .join('');
      chart.innerHTML =
        `<line class="maml-axis" x1="30" y1="96" x2="230" y2="96" />` +
        `<text class="maml-tick" x="26" y="16" text-anchor="end">${top.toFixed(2)}</text>` +
        `<text class="maml-tick" x="26" y="96" text-anchor="end">0</text>` +
        bars +
        ticks;
    };

    const render = () => {
      queued = false;
      const alpha = Number(input('alpha').value);
      const count = Number(input('count').value);
      const spread = Number(input('spread').value);
      const batchInput = input('batch');
      batchInput.max = String(count);
      if (Number(batchInput.value) > count) batchInput.value = String(count);
      const batch = Number(batchInput.value);

      value('alpha').textContent = alpha.toFixed(3);
      value('count').textContent = String(count);
      value('spread').textContent = spread.toFixed(2);
      value('batch').textContent = `${batch} / ${count}`;

      const tasks = makeTasks(count, spread, taskSeed);
      const mamlStar = stationary(tasks, alpha, 'maml');
      const jointStar = stationary(tasks, 0, 'joint');
      const fomamlStar = stationary(tasks, alpha, 'fomaml');
      const beta = outerStep(tasks, alpha);

      const parts: string[] = [];
      parts.push(`<line class="maml-axis" x1="0" y1="${sy(0)}" x2="${W}" y2="${sy(0)}" />`);
      parts.push(`<line class="maml-axis" x1="${sx(0)}" y1="0" x2="${sx(0)}" y2="${H}" />`);

      tasks.forEach((t) => {
        [0.3, 0.7].forEach((r) => {
          parts.push(`<path class="maml-task-contour" d="${path(ellipse(t.center, t.hessian, levelForMajorRadius(t.hessian, r)))}" />`);
        });
      });

      const M = meanWeight(tasks, alpha, 'maml');
      [0.5, 1, 1.6, 2.3, 3.1].forEach((r) => {
        parts.push(`<path class="maml-contour" d="${path(ellipse(mamlStar, M, levelForMajorRadius(M, r)))}" />`);
      });

      if (toggle('batch').checked && batch < count) {
        for (let s = 0; s < 3; s += 1) {
          const tr = trajectory(tasks, alpha, 'maml', start, beta, { batch, seed: batchSeed + s });
          parts.push(`<path class="maml-traj" data-series="batch" d="${path(tr.points)}" />`);
        }
      }
      const fomamlTraj = trajectory(tasks, alpha, 'fomaml', start, beta);
      if (toggle('joint').checked) {
        parts.push(`<path class="maml-traj" data-series="joint" d="${path(trajectory(tasks, alpha, 'joint', start, beta).points)}" />`);
      }
      if (toggle('fomaml').checked) {
        parts.push(`<path class="maml-traj" data-series="fomaml" d="${path(fomamlTraj.points)}" />`);
      }
      parts.push(`<path class="maml-traj" data-series="maml" d="${path(trajectory(tasks, alpha, 'maml', start, beta).points)}" />`);

      tasks.forEach((t) => {
        const a = adapt(t, alpha, start);
        parts.push(`<line class="maml-inner" x1="${sx(start[0])}" y1="${sy(start[1])}" x2="${sx(a[0])}" y2="${sy(a[1])}" />`);
        parts.push(dot(a, 'maml-adapted', 3));
        parts.push(cross(t.center, 'maml-center'));
      });

      if (toggle('joint').checked) parts.push(dot(jointStar, 'maml-star joint', 5.5));
      if (toggle('fomaml').checked && inView(fomamlStar)) parts.push(dot(fomamlStar, 'maml-star fomaml', 5.5));
      parts.push(dot(mamlStar, 'maml-star maml', 6.5));
      parts.push(dot(start, 'maml-start', 5));
      layer.innerHTML = parts.join('');

      const byBatch = spreadByBatch(tasks, alpha, start, beta);
      drawChart(byBatch, batch);

      out('after-maml').textContent = fmt(lossAfter(tasks, alpha, mamlStar));
      out('after-joint').textContent = fmt(lossAfter(tasks, alpha, jointStar));
      out('before-maml').textContent = fmt(lossBefore(tasks, mamlStar));
      out('before-joint').textContent = fmt(lossBefore(tasks, jointStar));
      out('gap').textContent = Math.hypot(mamlStar[0] - jointStar[0], mamlStar[1] - jointStar[1]).toFixed(3);
      out('curv').textContent = (alpha * maxCurvature(tasks)).toFixed(2);
      out('tail').textContent = byBatch[batch - 1].toFixed(3);
      out('diverged').hidden = !(toggle('fomaml').checked && fomamlTraj.diverged);
    };

    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(render);
    };

    svg.addEventListener('click', (event) => {
      const box = svg.getBoundingClientRect();
      start = toWorld(((event.clientX - box.left) / box.width) * W, ((event.clientY - box.top) / box.height) * H);
      schedule();
    });
    demo.querySelectorAll('input').forEach((el) => el.addEventListener('input', schedule));
    demo.querySelector('[data-action="tasks"]')!.addEventListener('click', () => {
      taskSeed += 1;
      schedule();
    });
    demo.querySelector('[data-action="batches"]')!.addEventListener('click', () => {
      batchSeed += 3;
      schedule();
    });
    render();
  });
</script>
